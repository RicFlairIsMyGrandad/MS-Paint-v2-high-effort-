{
  "name": "paintplus",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "A local Paint-style desktop editor with layers, editable assets and offline background removal",
  "author": "PaintPlus contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@playwright/test": "1.56.1",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "vite": "7.1.9"
  },
  "build": {
    "appId": "org.paintplus.desktop",
    "productName": "PaintPlus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "script": "desktop/installer.nsi",
      "installerLanguages": [
        "en_US"
      ],
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PaintPlus-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PaintPlus-Portable-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "paintplus",
        "name": "PaintPlus project",
        "role": "Editor"
      }
    ]
  }
}
